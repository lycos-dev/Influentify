# Railway PostgreSQL will normally inject DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influencer_reach?schema=public"
PORT=3000

# Optional: web discovery through Google results via Serper.
# The app still works without this; you can import/manual-add creators.
SERPER_API_KEY=""

# For local dev only. Production serves the React app from Express.
CLIENT_ORIGIN="http://localhost:5173"
