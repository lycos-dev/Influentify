# Local PostgreSQL. On Railway set DATABASE_URL to ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influentify?schema=public"
PORT=3000

# Brave Search API key. Keep this server-side only.
BRAVE_SEARCH_API_KEY=""

# App-side safety caps. Defaults are intentionally conservative.
# Current default budget is 900 Brave requests/month, below the current ~1,000-search monthly free credit allowance.
BRAVE_MONTHLY_REQUEST_BUDGET=900
BRAVE_MAX_REQUESTS_PER_RUN=24
DISCOVERY_DELAY_MS=180
DISCOVERY_HTTP_TIMEOUT_MS=15000
SOURCE_HTTP_TIMEOUT_MS=8000
SOURCE_FETCHES_PER_QUERY=8

# Local development only. Production serves React from Express.
CLIENT_ORIGIN="http://localhost:5173"
