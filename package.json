{
  "name": "influencer-reach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "postinstall": "npm run prisma:generate -w server",
    "railway:build": "npm run build",
    "db:push": "npm run db:push -w server",
    "db:migrate": "npm run db:migrate -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
